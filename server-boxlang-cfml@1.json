{
    "name":"stubble-boxlang-cfml@1",
    "app":{
        "serverHomeDirectory":".engine/boxlangCFML",
        "cfengine":"boxlang@^1.0.0"
    },
    "web":{
        "http":{
            "port":8520
        },
        "rewrites":{
            "enable":true
        }
    },
    "JVM":{
        "heapSize":"768",
        "javaVersion":"openjdk21_jre",
        "args":"-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=8888"
    },
    "openBrowser":false,
    "env":{},
    "scripts":{
        "onServerInitialInstall":"install bx-compat-cfml --noSave"
    }
}
